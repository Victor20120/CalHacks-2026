# Copy this file to .env in this same folder (backend/) and fill in the values.
# .env is never committed. Backend only: never put these values in frontend code.

# ---- CREAO API Trigger ----
# One key (capi_...) and app ID per agent.
# Create each key on that agent's page in agent.creao.ai.
CREAO_BASE_URL=https://agent.creao.ai/api/v1

# Hub agent (central research intelligence agent)
CREAO_HUB_APP_ID=
CREAO_HUB_KEY=

# Optional: a dedicated, lightweight Super Brain chat agent (much faster than the hub).
# Make it in agent.creao.ai (see Documents/super-brain-chat-agent.md) and paste its
# app ID and capi_ key here. While these are empty, chat uses the hub. Not needed if
# you made the hub itself lightweight instead (Way A in that guide).
CREAO_CHAT_APP_ID=
CREAO_CHAT_KEY=
# The model chat asks CREAO for. Empty uses a fast model (gemini-3-flash);
# "saved" keeps the agent's own model.
CREAO_CHAT_MODEL_ID=

# Personal agents, one per researcher (add or remove pairs as needed)
CREAO_AGENT_1_APP_ID=
CREAO_AGENT_1_KEY=
CREAO_AGENT_2_APP_ID=
CREAO_AGENT_2_KEY=
CREAO_AGENT_3_APP_ID=
CREAO_AGENT_3_KEY=

# Random string added to our webhook URL so we can ignore fake callbacks (Phase 6)
CREAO_WEBHOOK_TOKEN=
